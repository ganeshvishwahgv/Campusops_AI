{
  "name": "campusops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "auth:setup": "tsx scripts/setup-login.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:migrate": "npm run db:backup && prisma migrate deploy --config prisma7.config.ts && prisma generate --config prisma7.config.ts",
    "test:auth": "tsx --test --test-concurrency=1 tests/auth.test.ts tests/origin.test.ts",
    "db:rooms": "npm run db:backup && tsx prisma/add-rooms.ts",
    "db:team": "npm run db:backup && tsx prisma/demo-team.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "leaflet": "^1.9.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
